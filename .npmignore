# Source files - we only publish compiled files
tx_server/src/
tests/

# Development files
.gitignore
.npmignore
.git/
.txcode/

# Build files (but keep dist/ - that's what we publish)
# Note: dist/ is built by prepublishOnly and should be included
# tx_desktop/dist/ is also built by prepublishOnly and should be included

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
log/
doc/
docs/

# Environment files
.env
.env.local
.env.*.local

# Test coverage
coverage/

# TypeScript cache
*.tsbuildinfo

# Temporary files
*.tmp
temp/
.cluade
nul

# Config files (but keep package.json, README, LICENSE)
jest.config.mjs
tsconfig.json
postcss.config.js
tailwind.config.js
vite.config.js

# Documentation (but keep README.md)
*.md
!README.md

# Lock files (npm will handle dependencies)
package-lock.json

# Node modules - we don't publish these
node_modules/

# Desktop - only publish built frontend dist
tx_desktop/src/
tx_desktop/node_modules/
tx_desktop/release/
tx_desktop/assets/
tx_desktop/main.js
tx_desktop/preload.cjs
tx_desktop/electron-builder.yml
tx_desktop/installer.nsh
tx_desktop/index.html
tx_desktop/vite.config.js
tx_desktop/package-lock.json
tx_desktop/.npmrc
tx_desktop/.txcode/
tx_desktop/vite-dev.log