{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
"baseUrl": "./tx_server/src",
    "paths": {
      "@/*": ["./*"]
    },
    "lib": ["ES2021"],
    "jsx": "react",
    "outDir": "./dist",
    "rootDir": "./tx_server/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["tx_server/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}